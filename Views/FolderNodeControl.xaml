<UserControl x:Class="BimLinkManager.Views.FolderNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BimLinkManager.Views"
             xmlns:models="clr-namespace:BimLinkManager.Models"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/BlmTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared row chrome: idle muted, hover SurfaceHigh -->
            <Style x:Key="TreeRowBase" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Margin" Value="0,1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Folder header adds the selected state -->
            <Style x:Key="TreeRowFolder" TargetType="Border" BasedOn="{StaticResource TreeRowBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=local:FolderNodeControl}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Folder header row -->
        <Border x:Name="HeaderBorder"
                Style="{StaticResource TreeRowFolder}"
                MouseLeftButtonDown="HeaderBorder_Click"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="ExpandChevron"
                      Grid.Column="0"
                      Style="{StaticResource IconStroke}"
                      Data="{StaticResource IconChevronRight}"
                      Width="5" Height="9"
                      HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ExpandChevronRotate" Angle="0"/>
                    </Path.RenderTransform>
                </Path>

                <Path Grid.Column="1"
                      Style="{StaticResource IconStroke}"
                      Data="{StaticResource IconFolder}"
                      StrokeThickness="1.3"
                      Width="13" Height="13"
                      Margin="6,0,0,0"/>

                <TextBlock x:Name="NameText"
                           Grid.Column="2"
                           FontFamily="{StaticResource FontBody}"
                           FontWeight="Medium"
                           FontSize="12"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Children (subfolders + files): indented with a solid guide line -->
        <Border x:Name="ChildrenWrap"
                Margin="18,0,0,0"
                Padding="6,0,0,0"
                Visibility="Collapsed"
                BorderBrush="{StaticResource BorderMediumBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel>
                <ItemsControl x:Name="SubfolderList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AccFolder}">
                            <local:FolderNodeControl Folder="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="FileChildrenList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AccRvtFile}">
                            <Border Style="{StaticResource TreeRowBase}"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="FileNode_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="1"
                                          Style="{StaticResource IconStroke}"
                                          Data="{StaticResource IconDescription}"
                                          StrokeThickness="1.3"
                                          Width="13" Height="13"
                                          Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayName}"
                                               FontFamily="{StaticResource FontBody}"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
