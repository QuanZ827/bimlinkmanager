<UserControl x:Class="BimLinkManager.Views.LinkListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BimLinkManager.Views"
             xmlns:models="clr-namespace:BimLinkManager.Models"
             Background="#FFFFFF"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/BlmTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceLowestBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconStroke}"
                          Data="{StaticResource IconLink}"
                          Stroke="{StaticResource OnSurfaceVariantBrush}"
                          Width="16" Height="16"/>
                    <TextBlock Text="Project Links"
                               Style="{StaticResource HeadlineMd}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <Border Style="{StaticResource CountChipPrimary}" Margin="8,0,0,0">
                        <TextBlock x:Name="LinkCountText"
                                   Style="{StaticResource CountChipPrimaryText}"
                                   Text="0"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSecondary}"
                            Click="ReloadAllBtn_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStroke}"
                                  Data="{StaticResource IconRefresh}"
                                  StrokeThickness="1.4"
                                  Width="13" Height="13"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Reload All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPrimary}"
                            Click="ManageLinksBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStroke}"
                                  Data="{StaticResource IconExternalLink}"
                                  Width="13" Height="13"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Manage Links" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table header -->
        <Border DockPanel.Dock="Top"
                Height="34"
                Background="{StaticResource SurfaceLowBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="MODEL NAME" Style="{StaticResource LabelSm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource LabelSm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="2" Text="PATH TYPE" Style="{StaticResource LabelSm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="3" Text="WORKSET" Style="{StaticResource LabelSm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" Margin="16,0"/>
            </Grid>
        </Border>

        <!-- Rows area with centred empty-state overlay -->
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource BlmScrollBarV}"/>
            </ScrollViewer.Resources>
            <ItemsControl x:Name="LinkRows" Background="Transparent" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="44"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource RowDividerBrush}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <Path Style="{StaticResource IconStroke}"
                                          Data="{StaticResource IconDescription}"
                                          Stroke="{StaticResource DocIconBrush}"
                                          StrokeThickness="1.3"
                                          Width="12" Height="12"
                                          Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource LabelMd}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Status (F4: third badge) -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                    <Border Style="{StaticResource BadgeLoaded}"
                                            Visibility="{Binding IsLoadedVisibility}">
                                        <TextBlock Text="LOADED"
                                                   Style="{StaticResource Tag}"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource BadgeUnloaded}"
                                            Visibility="{Binding IsUnloadedVisibility}">
                                        <TextBlock Text="UNLOADED"
                                                   Style="{StaticResource Tag}"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource BadgeNotFound}"
                                            Visibility="{Binding IsNotFoundVisibility}">
                                        <TextBlock Text="NOT FOUND"
                                                   Style="{StaticResource Tag}"
                                                   Foreground="{StaticResource ErrorBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Path Type -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PathType}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="12"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center" Margin="16,0"/>

                                <!-- Workset -->
                                <ComboBox Grid.Column="3"
                                          Style="{StaticResource ComboFlat}"
                                          IsEditable="True"
                                          Margin="16,0"
                                          VerticalAlignment="Center"
                                          Text="{Binding WorksetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.WorksetNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                          LostFocus="WorksetCombo_LostFocus"
                                          Tag="{Binding}"
                                          IsEnabled="{Binding IsBusy, Converter={x:Static local:BoolInverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <Grid x:Name="EmptyState" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource IconStroke}"
                      Data="{StaticResource IconLink}"
                      Stroke="{StaticResource OnSurfaceVariantBrush}"
                      Width="40" Height="40"
                      Opacity="0.5"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,14"/>
                <TextBlock Text="No links in this project."
                           Style="{StaticResource BodySm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add some from the BATCH tab."
                           Style="{StaticResource LabelSm}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
