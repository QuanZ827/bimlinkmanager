<Window x:Class="BimLinkManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BimLinkManager.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BIM Link Manager"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#FFFFFF"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            NonClientFrameEdges="None"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/BlmTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BimLinkManager;component/Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================
                 ROW 0 — CHROME STRIP (custom titlebar)
                 ============================================================ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceLowestBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="ChromeDrag_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="BIM LINK MANAGER"
                               FontFamily="{StaticResource FontMono}"
                               FontWeight="Bold"
                               FontSize="9"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"
                               IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinBtn"
                                Style="{StaticResource BtnChrome}"
                                Click="MinBtn_Click"
                                ToolTip="Minimize">
                            <Path Data="{StaticResource IconWinMinimize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="MaxBtn"
                                Style="{StaticResource BtnChrome}"
                                Click="MaxBtn_Click"
                                ToolTip="Maximize">
                            <Path x:Name="MaxBtnIcon"
                                  Data="{StaticResource IconWinMaximize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="CloseBtn"
                                Style="{StaticResource BtnChromeClose}"
                                Click="CloseBtn_Click"
                                ToolTip="Close">
                            <Path Data="{StaticResource IconWinClose}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 ROW 1 — BRAND HEADER (brand | search | actions)
                 ============================================================ -->
            <Border Grid.Row="1"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="344"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="352"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand block -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceLowestBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,1,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <!-- Logo mark: 2x2 squares, opacity 1 / .5 / .5 / .25 -->
                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="8"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition Height="8"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource PrimaryBrush}"/>
                                <Rectangle Grid.Row="0" Grid.Column="2" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource PrimaryBrush}" Opacity="0.5"/>
                                <Rectangle Grid.Row="2" Grid.Column="0" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource PrimaryBrush}" Opacity="0.5"/>
                                <Rectangle Grid.Row="2" Grid.Column="2" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource PrimaryBrush}" Opacity="0.25"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BIM Link Manager" Style="{StaticResource HeadlineMd}"/>
                                <TextBlock Text="{Binding BrandSubtitle}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontWeight="Medium"
                                           FontSize="9"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid MaxWidth="420" Margin="20,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource InputSearch}"
                                     TextChanged="SearchBox_TextChanged"/>
                            <Path Style="{StaticResource IconStroke}"
                                  Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource OnSurfaceVariantBrush}"
                                  Width="13" Height="13"
                                  HorizontalAlignment="Left"
                                  Margin="10,0,0,0"
                                  IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search files…"
                                       FontFamily="{StaticResource FontBody}"
                                       FontSize="12"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Margin="30,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Header actions -->
                    <Grid Grid.Column="2" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnHeaderIcon}"
                                    ToolTip="Refresh"
                                    Click="RefreshBtn_Click">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconRefresh}"
                                      Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource BtnHeaderIcon}"
                                    ToolTip="Project Hierarchy"
                                    Margin="6,0,0,0">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconHierarchy}"
                                      Width="14" Height="14"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnHeaderIcon}"
                                    ToolTip="Notifications (coming soon)"
                                    IsEnabled="False"
                                    Margin="0,0,6,0">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconNotifications}"
                                      Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource BtnHeaderIcon}"
                                    ToolTip="Settings (coming soon)"
                                    IsEnabled="False">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconSettings}"
                                      Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================================
                 ROW 2 — NAV RAIL + CONTENT
                 ============================================================ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nav rail: BATCH on top, LINKS below -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceLowestBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                        <ToggleButton x:Name="NavBatch"
                                      Style="{StaticResource BtnNavTab}"
                                      IsChecked="True"
                                      Click="NavBatch_Click"
                                      ToolTip="Batch link"
                                      Margin="0,0,0,8">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconGrid}"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="BATCH"
                                           Style="{StaticResource NavLabel}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavLinks"
                                      Style="{StaticResource BtnNavTab}"
                                      Click="NavLinks_Click"
                                      ToolTip="Project links">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconLink}"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="LINKS"
                                           Style="{StaticResource NavLabel}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Content host -->
                <Grid Grid.Column="1">
                    <local:BatchView x:Name="BatchPane"/>
                    <local:LinkListView x:Name="LinkPane" Visibility="Collapsed"/>

                    <!-- Floating error toast (bottom-centre, clear of the pane footers) -->
                    <Border x:Name="ErrorToast"
                            Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,56"
                            Background="{StaticResource ErrorBgBrush}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,12"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" Opacity="0.14" Direction="270" ShadowDepth="4"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="22" Height="22"
                                    Background="{StaticResource ErrorBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top"
                                    Margin="0,1,10,0">
                                <TextBlock Text="!"
                                           FontFamily="{StaticResource FontBody}"
                                           FontWeight="ExtraBold"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ErrorToastTitle"
                                           FontFamily="{StaticResource FontHeadline}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="Heads up"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="ErrorToastMessage"
                                           Style="{StaticResource BodySm}"
                                           TextWrapping="Wrap"
                                           Text=""/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource BtnIconFlat}"
                                    Click="DismissErrorToast_Click"
                                    VerticalAlignment="Top"
                                    Margin="8,0,0,0">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="{StaticResource IconClose}"
                                      Width="11" Height="11"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
