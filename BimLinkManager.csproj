<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <AssemblyName>BimLinkManager</AssemblyName>
    <RootNamespace>BimLinkManager</RootNamespace>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Company>Zhequan Zhang</Company>
    <Authors>Zhequan Zhang</Authors>
    <Product>BIM Link Manager</Product>
    <Description>BIM Link Manager - Batch link cloud-hosted BIM models from Autodesk Construction Cloud.</Description>
    <Copyright>Copyright (c) 2026 Zhequan Zhang</Copyright>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <!-- Suppress warnings that are not actionable for Revit plugin development -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;NU1701;MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Revit 2024 (net48) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.40">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.40">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2024.3.40">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Revit 2025/2026/2027 (net8.0-windows). Reference 2025 API for forward compatibility -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.50">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.50">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2025.4.50">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>false</Private>
    </PackageReference>
  </ItemGroup>

  <!-- WPF assemblies on net48 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <!-- Embedded resources: icons + fonts -->
  <ItemGroup>
    <Resource Include="Resources\icon_16.png" Condition="Exists('Resources\icon_16.png')" />
    <Resource Include="Resources\icon_32.png" Condition="Exists('Resources\icon_32.png')" />
    <Resource Include="Resources\icon_96.png" Condition="Exists('Resources\icon_96.png')" />
    <Resource Include="Resources\Fonts\HankenGrotesk-Regular.ttf" />
    <Resource Include="Resources\Fonts\HankenGrotesk-Medium.ttf" />
    <Resource Include="Resources\Fonts\HankenGrotesk-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\HankenGrotesk-Bold.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Medium.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Bold.ttf" />
  </ItemGroup>

</Project>
